---
import Base from '../layouts/Base.astro';

const jobs = [
  {
    role: 'Ведущий инженер по тестированию, лид группы',
    org: 'АО «Неофлекс Консалтинг»',
    period: '01.2020 — н. в.',
    points: [
      'Веду тестирование своего набора сервисов: планирую проверки под изменения, оцениваю трудоёмкость, распределяю задачи в группе и ревьюю тест-кейсы и код.',
      'Разбираю требования и спецификации API, строю тестовую модель, ПМИ и сценарии функционального, интеграционного, регрессионного и E2E-тестирования.',
      'Проектирую и развиваю фреймворки автотестов на Java (JUnit 5, REST Assured, WireMock, Kafka, Playwright), встраиваю прогоны в Jenkins и GitLab CI.',
      'Поддерживаю тестовые окружения в Docker и Kubernetes, разворачиваю сервисы на стенды.',
      'Разбираю падения и инциденты по логам и дашбордам, отделяю дефекты продукта от проблем стенда.',
      'Готовлю отчёты по итогам тестирования для релизных решений, ввожу в проект новых инженеров.',
    ],
  },
  {
    role: 'Инженер по тестированию',
    org: 'АО «Неофлекс Консалтинг»',
    period: '10.2017 — 12.2019',
    points: [
      'Функциональное, интеграционное и регрессионное тестирование банковских систем.',
      'Тест-кейсы и чек-листы по требованиям, регистрация и проверка дефектов, SQL-проверки данных.',
      'Тестирование REST/SOAP-интеграций в Postman и SoapUI, UI- и API-автотесты на Selenium/Selenide, REST Assured, TestNG.',
    ],
  },
  {
    role: 'Разработчик 1С',
    org: 'ООО «Саратовгазавтоматика»',
    period: '01.2017 — 09.2017',
    points: ['Доработка и отладка конфигураций 1С, тестирование, внедрение и сопровождение, техническая документация.'],
  },
];

const projects = [
  {
    name: 'ВТБ — стрим «Страхование», кредитное страхование',
    note: 'текущий проект',
    text: 'Платформа кредитного страхования: 14 сервисов на Kotlin/Java и Spring Boot, Kafka, Camunda, PostgreSQL, микрофронтенды. Лид группы тестирования из трёх инженеров, автор фреймворка API-автотестов, CI в Jenkins с прогонами по изменившимся сервисам и ночным регрессом, карты покрытия по каждому сервису с расчётом полноты по JaCoCo.',
  },
  {
    name: 'РН Банк — автоматизация автокредитования',
    text: 'Кредитный конвейер и фронтовые приложения для дилеров. Пришёл ручным тестировщиком, затем руководил командой автоматизации из пяти инженеров: стабилизировал унаследованные UI- и API-тесты и перевёл регресс на ночные прогоны в Jenkins и GitLab CI.',
  },
  { name: 'SBI Банк', text: 'Дистанционное банковское обслуживание на микросервисах: функциональное и интеграционное тестирование.' },
  { name: 'Сетелем Банк', text: 'Автоматизация бизнес-процессов кредитования: тестирование процесса, фронта и интеграций.' },
  { name: 'СДМ-Банк', text: 'Контроль требований ПОД/ФТ на платформе SuiteCRM: функциональное и регрессионное тестирование.' },
];

// Стек — те же позиции, что в резюме, разложены по группам
const stack = [
  { group: 'Языки', items: ['Java', 'Kotlin', 'SQL'] },
  { group: 'Тестирование', items: ['JUnit 5', 'TestNG', 'REST Assured', 'Playwright', 'Selenium', 'Selenide', 'Selenoid', 'AssertJ', 'Awaitility', 'WireMock', 'ArchUnit', 'JaCoCo', 'Allure', 'Postman', 'SoapUI'] },
  { group: 'Платформа и данные', items: ['Spring Boot', 'Kafka', 'JMS', 'Camunda', 'Liquibase', 'PostgreSQL', 'Oracle', 'MS SQL'] },
  { group: 'CI и инфраструктура', items: ['Jenkins', 'GitLab CI', 'Git', 'Gradle', 'Maven', 'Docker', 'Kubernetes / OpenShift', 'Helm', 'Nexus'] },
  { group: 'Наблюдаемость и процесс', items: ['Grafana', 'Kibana', 'Prometheus', 'Jira', 'Confluence', 'IntelliJ IDEA'] },
];
---
<Base title="CV" description="Максим Егоров — Senior QA Automation Engineer / Lead QA: опыт, стек, достижения.">
  <section class="hero">
    <p class="eyebrow">CV</p>
    <h1>Senior QA Automation Engineer / Lead QA</h1>
    <p class="lead">В тестировании с 2017 года, почти всё это время — банковские и страховые проекты на микросервисах. Совмещаю две роли: <span class="mark">лид группы тестирования и автор фреймворка автотестов</span>, который держит их прогоны в CI.</p>
    <p class="narrow muted">Начинал с ручного функционального тестирования, затем ушёл в автоматизацию на Java. Мне интересно понять, как устроена система: разобрать Kafka-поток или BPMN-процесс, найти по логам, где всё пошло не так, и построить покрытие так, чтобы пробелы были видны до релиза.</p>
    <div class="actions">
      <a class="btn btn-primary" href="https://t.me/heapnotes" rel="me">Telegram</a>
      <a class="btn" href="https://github.com/egorov-ma" rel="me">GitHub</a>
      <a class="btn" href="/projects/">Проекты</a>
    </div>
  </section>

  <section id="achievements">
    <p class="eyebrow"><span>01</span>Результаты</p>
    <h2>Достижения</h2>
    <div class="grid grid-3">
      <div class="card metric"><b>1 200+</b><p>С нуля построил фреймворк API-автотестов для кредитного страхования, на нём работают шесть команд стрима: автотесты по 14 микросервисам (REST, Kafka, JMS, Camunda), ночной регресс и точечные прогоны вместо ручного регресса в 3–4 дня.</p></div>
      <div class="card metric"><b>140+</b><p>Ввёл карту покрытия «бизнес-процесс → требование → тест»: по ней планируем автоматизацию и показываем заказчику, что реально закрыто. За проект подтверждено больше 140 дефектов.</p></div>
      <div class="card metric"><b>5</b><p>Возглавил команду автоматизации из пяти человек и довёл унаследованный набор Selenium и REST Assured тестов до стабильного ночного регресса в Jenkins и GitLab CI.</p></div>
    </div>
  </section>

  <section id="experience">
    <p class="eyebrow"><span>02</span>Карьера</p>
    <h2>Опыт</h2>
    <ol class="timeline">
      {jobs.map((j) => (
        <li>
          <div class="job-head"><h3>{j.role}</h3><span class="job-meta">{j.period}</span></div>
          <div class="org">{j.org}</div>
          <ul class="points">{j.points.map((p) => <li>{p}</li>)}</ul>
        </li>
      ))}
    </ol>
    <h3 style="margin-top:40px">Проекты</h3>
    <div class="engagements">
      {projects.map((p) => (
        <div class="engagement">
          <h4>{p.name}{p.note && <span class="badge">{p.note}</span>}</h4>
          <p>{p.text}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="stack">
    <p class="eyebrow"><span>03</span>Инструменты</p>
    <h2>Стек</h2>
    <div class="grid grid-2">
      {stack.map((g) => (
        <div class="stack-group">
          <h3>{g.group}</h3>
          <ul class="tags">{g.items.map((s) => <li>{s}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section id="education">
    <p class="eyebrow"><span>04</span>Обучение</p>
    <h2>Образование</h2>
    <div class="card">
      <h3>Саратовский государственный университет им. Н. Г. Чернышевского, 2016</h3>
      <p>Факультет компьютерных наук и информационных технологий, «Математическое обеспечение и администрирование информационных систем».</p>
      <p class="muted" style="margin-top:10px">Курсы: «Лидерство в команде» (2019), «Java для тестировщиков» (2019). Английский — B1: техническая документация и деловая переписка.</p>
    </div>
  </section>
</Base>

---
import Base from '../layouts/Base.astro';

const jobs = [
  {
    role: 'Ведущий инженер по тестированию, лид группы',
    org: 'АО «Неофлекс Консалтинг»',
    period: '01.2020 — н. в.',
    points: [
      'Веду тестирование своего набора сервисов: планирую проверки под изменения, оцениваю трудоёмкость, распределяю задачи в группе и ревьюю тест-кейсы и код.',
      'Разбираю требования и спецификации API, строю тестовую модель, ПМИ и сценарии функционального, интеграционного, регрессионного и E2E-тестирования.',
      'Проектирую и развиваю фреймворки автотестов на Java (JUnit 5, REST Assured, WireMock, Kafka, Playwright), встраиваю прогоны в Jenkins и GitLab CI.',
      'Поддерживаю тестовые окружения в Docker и Kubernetes, разворачиваю сервисы на стенды.',
      'Разбираю падения и инциденты по логам и дашбордам, отделяю дефекты продукта от проблем стенда.',
      'Готовлю отчёты по итогам тестирования для релизных решений, ввожу в проект новых инженеров.',
    ],
  },
  {
    role: 'Инженер по тестированию',
    org: 'АО «Неофлекс Консалтинг»',
    period: '10.2017 — 12.2019',
    points: [
      'Функциональное, интеграционное и регрессионное тестирование банковских систем.',
      'Тест-кейсы и чек-листы по требованиям, регистрация и проверка дефектов, SQL-проверки данных.',
      'Тестирование REST/SOAP-интеграций в Postman и SoapUI, UI- и API-автотесты на Selenium/Selenide, REST Assured, TestNG.',
    ],
  },
  {
    role: 'Разработчик 1С',
    org: 'ООО «Саратовгазавтоматика»',
    period: '01.2017 — 09.2017',
    points: ['Доработка и отладка конфигураций 1С, тестирование, внедрение и сопровождение, техническая документация.'],
  },
];

const projects = [
  {
    name: 'ВТБ — стрим «Страхование», кредитное страхование',
    note: 'текущий проект',
    text: 'Платформа кредитного страхования: 14 сервисов на Kotlin/Java и Spring Boot, Kafka, Camunda, PostgreSQL, микрофронтенды. Лид группы тестирования из трёх инженеров, автор фреймворка API-автотестов, CI в Jenkins с прогонами по изменившимся сервисам и ночным регрессом, карты покрытия по каждому сервису с расчётом полноты по JaCoCo.',
  },
  {
    name: 'РН Банк — автоматизация автокредитования',
    text: 'Кредитный конвейер и фронтовые приложения для дилеров. Пришёл ручным тестировщиком, затем руководил командой автоматизации из пяти инженеров: стабилизировал унаследованные UI- и API-тесты и перевёл регресс на ночные прогоны в Jenkins и GitLab CI.',
  },
  { name: 'SBI Банк', text: 'Дистанционное банковское обслуживание на микросервисах: функциональное и интеграционное тестирование.' },
  { name: 'Сетелем Банк', text: 'Автоматизация бизнес-процессов кредитования: тестирование процесса, фронта и интеграций.' },
  { name: 'СДМ-Банк', text: 'Контроль требований ПОД/ФТ на платформе SuiteCRM: функциональное и регрессионное тестирование.' },
];

const stack = ['Java', 'Kotlin', 'SQL', 'JUnit 5', 'TestNG', 'REST Assured', 'Playwright', 'Selenium', 'Selenide', 'Selenoid', 'AssertJ', 'Awaitility', 'WireMock', 'ArchUnit', 'JaCoCo', 'Gradle', 'Maven', 'Kafka', 'JMS', 'Camunda', 'Spring Boot', 'Liquibase', 'PostgreSQL', 'Oracle', 'MS SQL'];
const tools = ['Jenkins', 'GitLab CI', 'Git', 'Docker', 'Kubernetes / OpenShift', 'Helm', 'Nexus', 'Allure', 'Postman', 'SoapUI', 'Grafana', 'Kibana', 'Prometheus', 'Jira', 'Confluence', 'IntelliJ IDEA'];
---
<Base title="CV" description="Максим Егоров — Senior QA Automation Engineer / Lead QA: опыт, стек, достижения.">
  <h1>CV</h1>
  <p class="lead">Senior QA Automation Engineer / Lead QA. В тестировании с 2017 года, почти всё это время — банковские и страховые проекты на микросервисах.</p>
  <p>Начинал с ручного функционального тестирования, затем ушёл в автоматизацию на Java. Последние годы совмещаю две роли: лид группы тестирования и автор фреймворка автотестов, который держит их прогоны в CI. Мне интересно понять, как устроена система: разобрать Kafka-поток или BPMN-процесс, найти по логам, где всё пошло не так, и построить покрытие так, чтобы пробелы были видны до релиза.</p>

  <section id="achievements">
    <h2>Достижения</h2>
    <ul class="points">
      <li>С нуля построил фреймворк API-автотестов для кредитного страхования, на нём работают шесть команд стрима: больше 1 200 автотестов по 14 микросервисам (REST, Kafka, JMS, Camunda), ночной регресс и точечные прогоны вместо ручного регресса в 3–4 дня.</li>
      <li>Ввёл карту покрытия «бизнес-процесс → требование → тест»: по ней планируем автоматизацию и показываем заказчику, что реально закрыто. За проект подтверждено больше 140 дефектов.</li>
      <li>Возглавил команду автоматизации из пяти человек и довёл унаследованный набор Selenium и REST Assured тестов до стабильного ночного регресса в Jenkins и GitLab CI.</li>
    </ul>
  </section>

  <section id="experience">
    <h2>Опыт</h2>
    {jobs.map((j) => (
      <article class="job">
        <div class="job-head"><h3>{j.role}</h3><span class="job-meta">{j.period}</span></div>
        <div class="muted">{j.org}</div>
        <ul class="points">{j.points.map((p) => <li>{p}</li>)}</ul>
      </article>
    ))}
    <h3 style="margin-top:24px">Проекты</h3>
    {projects.map((p) => (
      <article class="job">
        <div class="job-head"><h3>{p.name}</h3>{p.note && <span class="job-meta">{p.note}</span>}</div>
        <p class="muted" style="margin:6px 0 0">{p.text}</p>
      </article>
    ))}
  </section>

  <section id="stack">
    <h2>Стек</h2>
    <ul class="tags">{stack.map((s) => <li>{s}</li>)}</ul>
    <h3 style="margin-top:18px">Инструменты</h3>
    <ul class="tags">{tools.map((s) => <li>{s}</li>)}</ul>
  </section>

  <section id="education">
    <h2>Образование</h2>
    <p>Саратовский государственный университет им. Н. Г. Чернышевского, 2016. Факультет компьютерных наук и информационных технологий, «Математическое обеспечение и администрирование информационных систем».</p>
    <p class="muted">Курсы: «Лидерство в команде» (2019), «Java для тестировщиков» (2019). Английский — B1: техническая документация и деловая переписка.</p>
  </section>
</Base>

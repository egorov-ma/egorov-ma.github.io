---
import Base from '../../layouts/Base.astro';

// Заметки — markdown-файлы рядом; новые сверху
const notes = Object.values(import.meta.glob('./*.md', { eager: true }))
  .map((n: any) => ({ url: n.url, ...n.frontmatter }))
  .sort((a, b) => +new Date(b.date) - +new Date(a.date));
---
<Base title="Заметки" description="Короткие заметки Максима Егорова: пет-проекты, тестирование, домашняя инфраструктура.">
  <section class="hero">
    <p class="eyebrow">Заметки</p>
    <h1>Короткие тексты</h1>
    <p class="lead">О пет-проектах, тестировании и домашней инфраструктуре. Длинное и сырое — в <a href="https://t.me/heapnotes">канале</a>.</p>
  </section>
  <ul class="note-list narrow">
    {notes.map((n) => (
      <li>
        <a class="card" href={n.url}>
          <time datetime={new Date(n.date).toISOString().slice(0, 10)}>{new Date(n.date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time>
          <h3 style="margin-top:6px">{n.title}</h3>
          {n.description && <p>{n.description}</p>}
        </a>
      </li>
    ))}
  </ul>
</Base>
